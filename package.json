{
  "name": "aiomm",
  "version": "0.1.0",
  "description": "All in one mod manager (AioMM) for 3DMigoto and XXMI",
  "author": "Caya8205",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "tauri:dev": "tauri dev",
    "tauri:build": "npm run build && cargo clean --manifest-path src-tauri/Cargo.toml -p aiomm && cargo build --release --manifest-path src-tauri/Cargo.toml --features custom-protocol",
    "version:sync": "node scripts/sync-version.mjs"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "clsx": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
