{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "All in one mod manager",
  "version": "0.1.0",
  "identifier": "dev.caya.aiomm",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "All in one mod manager (AIOMM)",
        "width": 1180,
        "height": 760,
        "minWidth": 360,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Caya8205",
    "copyright": "Copyright © 2026 Caya8205",
    "shortDescription": "All in one mod manager",
    "longDescription": "All in one mod manager (AIOMM) for 3DMigoto and XXMI",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
